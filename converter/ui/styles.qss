/* ============================================================
   SGMF 转换器 — 深色主题
   ============================================================ */

* {
    font-family: "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
}

QMainWindow, QWidget {
    background-color: #1E1E2E;
    color: #CDD6F4;
    font-size: 13px;
}

QDialog {
    background-color: #1E1E2E;
}

/* ---------- 标题 ---------- */
QLabel#AppTitle {
    font-size: 22px;
    font-weight: bold;
    color: #CDD6F4;
}

QLabel#AppSubtitle {
    font-size: 13px;
    color: #7F849C;
    margin-bottom: 4px;
}

QLabel#SectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #CDD6F4;
}

QLabel#FieldLabel {
    color: #A6ADC8;
    font-size: 13px;
}

QLabel#DialogHint {
    color: #A6ADC8;
    font-size: 13px;
    line-height: 1.5;
}

/* ---------- 拖入区 ---------- */
QFrame#DropArea {
    background-color: #2A2A3C;
    border: 2px dashed #45475A;
    border-radius: 12px;
}

QFrame#DropArea:hover {
    background-color: #2F2F44;
    border-color: #585B70;
}

QFrame#DropArea[dragActive="true"] {
    background-color: #353550;
    border-color: #7C5CFC;
}

QFrame#DropArea:disabled {
    background-color: #232334;
    border-color: #313244;
}

QLabel#DropIcon {
    font-size: 40px;
    color: #7C5CFC;
    font-weight: bold;
}

QLabel#DropTitle {
    font-size: 16px;
    font-weight: 600;
    color: #CDD6F4;
    margin-top: 2px;
}

QLabel#DropHint {
    font-size: 12px;
    color: #7F849C;
    margin-top: 2px;
}

/* ---------- 输入框 ---------- */
QLineEdit {
    background-color: #2A2A3C;
    border: 1px solid #45475A;
    border-radius: 8px;
    padding: 8px 12px;
    color: #CDD6F4;
    selection-background-color: #7C5CFC;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border-color: #7C5CFC;
}

QLineEdit:hover:!focus {
    border-color: #585B70;
}

QLineEdit:disabled {
    background-color: #232334;
    color: #6C7086;
    border-color: #313244;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #45475A;
    color: #CDD6F4;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #585B70;
}

QPushButton:pressed {
    background-color: #3A3C4E;
}

QPushButton:disabled {
    background-color: #2A2A3C;
    color: #6C7086;
}

QPushButton#PrimaryButton {
    background-color: #7C5CFC;
    color: #FFFFFF;
    font-weight: 600;
    padding: 10px 28px;
}

QPushButton#PrimaryButton:hover {
    background-color: #9B7FFF;
}

QPushButton#PrimaryButton:pressed {
    background-color: #6A4BE0;
}

QPushButton#PrimaryButton:disabled {
    background-color: #45475A;
    color: #7F849C;
}

QPushButton#GhostButton {
    background-color: transparent;
    border: 1px solid #45475A;
    color: #CDD6F4;
}

QPushButton#GhostButton:hover {
    background-color: #2A2A3C;
    border-color: #585B70;
}

QPushButton#GhostButton:pressed {
    background-color: #232334;
}

QPushButton#GhostButton:disabled {
    color: #6C7086;
    border-color: #313244;
}

QPushButton#IconButton {
    background-color: transparent;
    border: 1px solid #45475A;
    border-radius: 8px;
    padding: 6px 10px;
    color: #A6ADC8;
}

QPushButton#IconButton:hover {
    background-color: #2A2A3C;
    color: #CDD6F4;
}

QPushButton#IconButton:checked {
    background-color: #7C5CFC;
    border-color: #7C5CFC;
    color: #FFFFFF;
}

/* ---------- 表格 ---------- */
QTableWidget {
    background-color: #2A2A3C;
    alternate-background-color: #27273A;
    border: 1px solid #313244;
    border-radius: 10px;
    gridline-color: transparent;
    selection-background-color: #45475A;
    selection-color: #CDD6F4;
    outline: none;
    padding: 2px;
}

QTableWidget::item {
    padding: 6px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #45475A;
}

QHeaderView::section {
    background-color: #1E1E2E;
    color: #A6ADC8;
    padding: 10px 8px;
    border: none;
    border-bottom: 1px solid #313244;
    font-weight: 600;
}

QTableWidget QTableCornerButton::section {
    background-color: #1E1E2E;
    border: none;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    background-color: #2A2A3C;
    border: none;
    border-radius: 8px;
    height: 22px;
    text-align: center;
    color: #CDD6F4;
    font-size: 12px;
}

QProgressBar::chunk {
    background-color: #7C5CFC;
    border-radius: 8px;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #45475A;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #585B70;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #45475A;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #585B70;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0;
    border: none;
}

/* ---------- 消息框 ---------- */
QMessageBox {
    background-color: #1E1E2E;
}

QMessageBox QLabel {
    color: #CDD6F4;
    font-size: 13px;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ---------- 工具提示 ---------- */
QToolTip {
    background-color: #313244;
    color: #CDD6F4;
    border: 1px solid #45475A;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}
/* ---------- 启动验证对话框 ---------- */
QLabel#AuthTitle {
    font-size: 18px;
    font-weight: 600;
    color: #CDD6F4;
}

QLabel#AuthHint {
    font-size: 13px;
    color: #A6ADC8;
}